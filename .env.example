# Copia de referencia del archivo .env (el portal crea .env automáticamente la primera vez).
PORT=8000
MODO=desarrollo
# Clave secreta de al menos 32 caracteres. Se genera sola; no la publique.
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria-de-64-caracteres
SESION_HORAS=8
ADMIN_CORREO=admin@antioquia.example
ADMIN_PASSWORD=Admin2026*
ADMIN_NOMBRE=Administrador del Sistema
# Opcional: clave de un modelo de lenguaje para el asistente. Vacío = modo reglas.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
